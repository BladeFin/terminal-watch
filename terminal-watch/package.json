{
  "name": "terminal-watch",
  "displayName": "Terminal Watch",
  "publisher": "BladeFin",
  "description": "Monitors terminal output for regex patterns and alerts you when your commands finish — including CLI AI agents like Claude Code, Codex, and Freebuff. Desktop notifications are delivered by the Terminal Watch Notifier extension.",
  "version": "0.0.3",
  "icon": "icon.png",
  "license": "MIT",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other",
    "AI"
  ],
  "keywords": [
    "terminal",
    "notification",
    "notify",
    "monitor",
    "regex",
    "devcontainer",
    "remote",
    "ai",
    "agent",
    "agentic",
    "claude code",
    "claude",
    "codex",
    "freebuff",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "BladeFin.terminal-watch-notifier"
  ],
  "contributes": {
    "configuration": {
      "title": "Terminal Watch",
      "properties": {
        "terminalWatch.autoListeningEnabled": {
          "type": "boolean",
          "default": false,
          "description": "Start listening for triggers automatically when Terminal Watch activates. When disabled (default), listening stays OFF until you enable it from the Terminal Watch status bar menu."
        },
        "terminalWatch.notificationMode": {
          "type": "string",
          "enum": [
            "Desktop",
            "VS Code",
            "Both"
          ],
          "default": "Both"
        },
        "terminalWatch.triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "End Session",
            "Build successful",
            "\\d+ tests passed"
          ],
          "description": "Regular expressions that trigger a notification when detected in the terminal."
        },
        "terminalWatch.cooldownSeconds": {
          "type": "number",
          "default": 5,
          "description": "Minimum seconds between notifications."
        },
        "terminalWatch.shellPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Custom path to the shell executable (leave blank to auto-detect OS default)."
        }
      }
    },
    "commands": [
      {
        "command": "terminal-watch.createWatchedTerminal",
        "title": "Terminal Watch: Create Watched Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "terminal-watch.openMenu",
        "title": "Terminal Watch: Open Menu",
        "icon": "$(terminal)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}

{
  "name": "terminal-watch-notifier",
  "displayName": "Terminal Watch Notifier",
  "publisher": "BladeFin",
  "repository": {
    "type": "git",
    "url": "https://github.com/BladeFin/terminal-watch.git",
    "directory": "terminal-watch-notifier"
  },
  "description": "Companion to Terminal Watch: raises native OS desktop notifications via node-notifier when your command — or CLI AI agent — finishes. Runs on the UI host so notifications work even when Terminal Watch runs in a container or remote workspace.",
  "version": "1.0.0",
  "icon": "icon.png",
  "license": "MIT",
  "api": "none",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "notification",
    "notify",
    "desktop",
    "terminal",
    "node-notifier",
    "ui",
    "ai",
    "agent",
    "claude code",
    "codex",
    "freebuff"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --format=cjs --external:vscode",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/node-notifier": "^8.0.5",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "node-notifier": "^10.0.1"
  }
}
